# Cấu hình Backend LMS NestJS
PORT=3000
NODE_ENV=development

# Cấu hình Cơ Sở Dữ Liệu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=lms_db
