PORT=3000

# Chế độ hoạt động máy chủ CSDL:
# - DEMO_MODE=false: Sử dụng cơ sở dữ liệu MySQL thật (khuyến nghị khi nộp bài/bảo vệ, import file lms_db.sql đủ 30 bảng).
# - DEMO_MODE=true: Chế độ In-Memory Fallback (chạy thử nhanh độc lập không bắt buộc bật dịch vụ MySQL).
DEMO_MODE=false

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=lms_db
# DB_SYNCHRONIZE=false để bảo vệ toàn vẹn schema CSDL production theo chuẩn R02
DB_SYNCHRONIZE=false

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
